                                                <msItem xml:id="vhmm-124496-item-1" class="part-1">
                                                    <title xml:lang="en">Rule for the Confraternity of Moses the Ethiopian</title>
                                                    <title xml:lang="en">ܐܠܪܣܘܡ</title>
                                                    <incipit>
                                                        <quote>ܝܠܙܡ ܠܟܠ ܫܟܨܐ ܡܢ ܗܕܗ ܐܠܐܒܘܝܗ̈ ܐܠܡܩܕܣܗ ܩܒܠ ܟܠ ܫܝܐ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736174; content-contributor: {&quot;id&quot;: 630582, &quot;type&quot;: &quot;Author&quot;, &quot;contributor&quot;: {&quot;id&quot;: 4518, &quot;name&quot;: &quot;Jarwah, Ighnāṭiyūs Mīkhāʼīl, Patriarch of Antioch, 1730-1800&quot;, &quot;authorityUriVIAF&quot;: &quot;https://viaf.org/viaf/185144782955180391815&quot;, &quot;displayName&quot;: &quot;Jarwah, Ighnāṭiyūs Mīkhāʼīl, Patriarch of Antioch, 1730-1800&quot;}}; Title classification: provisional: Rule for the Confraternity of Moses the Ethiopian; Title classification: original: ܐܠܪܣܘܡ</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-2" class="part-1">
                                                    <title xml:lang="en">Prayers, liturgical texts, and magical texts</title>
                                                    <title xml:lang="en">ܟܬܐܒ ܨܠܐܗ̈</title>
                                                    <textLang mainLang="syr"/>
                                                    <incipit>
                                                        <quote>ܐܥܬܩܕ ܒܐܠܐܡܐܢܗ̈ ܐܣܓܕ ܠܟ ܐܝܗܐ ܐܠܐܒ ܘܐܠܐܒܢ ܘܐܠܪܘܚ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736175; Title classification: provisional: Prayers, liturgical texts, and magical texts; Title classification: original: ܟܬܐܒ ܨܠܐܗ̈</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-3" class="part-1">
                                                    <title xml:lang="en">Story of Solomon, son of David</title>
                                                    <title xml:lang="en">ܣܪܩܘܒܐܛ ܣܠܝܡܐܢ ܐܠܚܟܝܡ ܐܒܢ ܕܐܘܘܕ</title>
                                                    <incipit>
                                                        <quote>ܘܟܐܢ ܣܠܝܡܐܢ ܕܐܬ ܝܘܡ ܓܐܠܣܐ ܦܝ ܡܠܟܗ ܘܡܓܕܗ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736176; Title classification: provisional: Story of Solomon, son of David; Title classification: original: ܣܪܩܘܒܐܛ ܣܠܝܡܐܢ ܐܠܚܟܝܡ ܐܒܢ ܕܐܘܘܕ</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-4" class="part-1">
                                                    <title xml:lang="en">Psalter. Selections</title>
                                                    <title xml:lang="en">ܡܙܡܘܪ̈ܐ</title>
                                                    <title xml:lang="en">Psalter (Syriac Rite, Western)</title>
                                                    <textLang mainLang="syr"/>
                                                    <incipit>
                                                        <quote>ܐܠܗܝ ܐܠܗܝ ܠܡܢܐ ܫܒܩܬܢܝ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736177; Title classification: provisional: Psalter. Selections; Title classification: original: ܡܙܡܘܪ̈ܐ; Title classification: uniform: Psalter (Syriac Rite, Western)</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-5" class="part-1">
                                                    <title xml:lang="en">Nicene Creed</title>
                                                    <title xml:lang="en">ܬܚܘܡܐ ܕܗܝܡܢܘܬܐ ܕܬܠܬ ܡܐܐ ܘܬܡܢܬ ܥܣܪ ܐܒܗ̈ܬܐ ܩܕܝ̈ܫܐ ܕܐܬܟܢܘ ܒܢܝܩܝܐ</title>
                                                    <title xml:lang="en">Nicene Creed</title>
                                                    <title xml:lang="en">Definition of faith of the 318 fathers against the doctrine of Arius</title>
                                                    <textLang mainLang="syr"/>
                                                    <incipit>
                                                        <quote>ܡܗܝܡܢܝܢ ܒܚܕ ܐܠܗܐ ܫܪܝܪܐ ܐܒܐ ܐܚܝܕ ܟܠ ܥܒܘܕܐ ܕܫܡܝܐ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736178; Title classification: provisional: Nicene Creed; Title classification: original: ܬܚܘܡܐ ܕܗܝܡܢܘܬܐ ܕܬܠܬ ܡܐܐ ܘܬܡܢܬ ܥܣܪ ܐܒܗ̈ܬܐ ܩܕܝ̈ܫܐ ܕܐܬܟܢܘ ܒܢܝܩܝܐ; Title classification: uniform: Nicene Creed; Title classification: alternative: Definition of faith of the 318 fathers against the doctrine of Arius</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-6" class="part-1">
                                                    <title xml:lang="en">Lord&apos;s prayer</title>
                                                    <title xml:lang="en">ܨܠܐܗ̈ ܐܠܪܒܐܢܝܗ̈</title>
                                                    <title xml:lang="en">Lord&apos;s prayer</title>
                                                    <incipit>
                                                        <quote>ܐܒܐܢܐ ܐܠܕܝ ܦܝ ܐܠܣܡܘܐܬ ܠܝܬܩܕܣ ܐܣܡܟ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736179; Title classification: provisional: Lord&apos;s prayer; Title classification: original: ܨܠܐܗ̈ ܐܠܪܒܐܢܝܗ̈; Title classification: uniform: Lord&apos;s prayer</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-7" class="part-1">
                                                    <title xml:lang="en">Homily on teaching</title>
                                                    <title xml:lang="en">ܡܐܡܪܐ ܕܥܠ ܝܘܠܦܢܐ</title>
                                                    <title xml:lang="en">Ephraem, Syrus, Saint, 303-373. Sermons</title>
                                                    <textLang mainLang="syr"/>
                                                    <incipit>
                                                        <quote>ܐܠܗܐ ܗܒ ܝܘܠܦܢܐ ܠܐܝܢܐ ܕܪ̈ܚܡ ܝܘܠܦܢܐ ܘܠܪܒܐ ܕܡܠܦ ܫܦܝܪ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736180; content-contributor: {&quot;id&quot;: 630583, &quot;type&quot;: &quot;Author&quot;, &quot;nameNs&quot;: &quot;ܩܕܝܫܐ ܡܪܝ ܐܦܪܝܡ&quot;, &quot;contributor&quot;: {&quot;id&quot;: 3494, &quot;name&quot;: &quot;Ephraem, Syrus, Saint, 303-373&quot;, &quot;authorityUriLC&quot;: &quot;https://id.loc.gov/authorities/names/n50082928&quot;, &quot;authorityUriVIAF&quot;: &quot;https://viaf.org/viaf/100177778&quot;, &quot;displayName&quot;: &quot;Ephrem, of Nisibis, 303-373&quot;}}; Title classification: provisional: Homily on teaching; Title classification: original: ܡܐܡܪܐ ܕܥܠ ܝܘܠܦܢܐ; Title classification: uniform: Ephraem, Syrus, Saint, 303-373. Sermons</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-8" class="part-1">
                                                    <title xml:lang="en">Names of all the angels</title>
                                                    <title xml:lang="en">ܐܣܐܡܝ ܓܡܝܥ ܐܠܡܠܐܝܟܗ</title>
                                                    <textLang mainLang="syr"/>
                                                    <incipit>
                                                        <quote>ܘܫܡܗ̈ܐ ܕܡܠܐܟ̈ܐ ܩܕܝ̈ܫܐ ܓܒܪܐܝܠ ܘܡܝܟܐܝܠ ܥܛܐܝܠ ܠܫܛܐܝܠ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736181; Title classification: provisional: Names of all the angels; Title classification: original: ܐܣܐܡܝ ܓܡܝܥ ܐܠܡܠܐܝܟܗ</note>
                                                </msItem>
                                                <msItem xml:id="vhmm-124496-item-9" class="part-1">
                                                    <title xml:lang="en">Divination by the names of biblical figures</title>
                                                    <title xml:lang="en">ܩܪܥܗ̈ ܐܠܬܠܐܡܝܕ</title>
                                                    <incipit>
                                                        <quote>ܐܘܠܟܝ ܩܐܒܘ ܐܕܡ</quote>
                                                    </incipit>
                                                    <note xml:lang="en">vHMML part 1 (ID 954265); catalogue-content-id: 1736182; Title classification: provisional: Divination by the names of biblical figures; Title classification: original: ܩܪܥܗ̈ ܐܠܬܠܐܡܝܕ</note>
                                                </msItem>

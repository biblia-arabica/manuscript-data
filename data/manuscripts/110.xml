                                                <summary xml:lang="en">Genesis, for Coptic use, with commentary of Mark ibn Qanbar</summary>
                                                <msItem xml:id="bnf-arabe-21-item-1">
                                                    <locus from="1" to="179"/>
                                                    <title>Genesis, for Coptic use, with commentary of Mark ibn Qanbar</title>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Text identical to that of MS Arabe 18.</note>
                                                </msItem>

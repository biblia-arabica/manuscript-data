                                                                <width unit="mm">200</width>
                                                            </dimensions>
                                                        </extent>
                                                    </supportDesc>
                                                    <layoutDesc>
                                                        <summary>
                                                            <note xml:lang="en">21-22 lines per page. Gatherings numbered in Arabic letters, 10 folios per gathering.</note>

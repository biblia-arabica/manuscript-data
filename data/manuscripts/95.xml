                                            <msContents>
                                                <summary xml:lang="en">Pentateuch, for Samaritan use</summary>
                                                <msItem xml:id="bnf-arabe-6-item-1">
                                                    <locus from="2" to="2"/>
                                                    <title>Introduction of Abū Saʿīd</title>
                                                    <textLang mainLang="ar"/>
                                                </msItem>
                                                <msItem xml:id="bnf-arabe-6-item-2">
                                                    <locus from="2v" to="93"/>
                                                    <title>Genesis</title>
                                                    <textLang mainLang="ar"/>
                                                </msItem>
                                                <msItem xml:id="bnf-arabe-6-item-3">
                                                    <locus from="93v" to="167v"/>
                                                    <title>Exodus</title>
                                                    <textLang mainLang="ar"/>
                                                </msItem>
                                                <msItem xml:id="bnf-arabe-6-item-4">
                                                    <locus from="168" to="217"/>
                                                    <title>Leviticus</title>
                                                    <textLang mainLang="ar"/>
                                                </msItem>
                                                <msItem xml:id="bnf-arabe-6-item-5">
                                                    <locus from="217v" to="295"/>
                                                    <title>Numbers</title>
                                                    <textLang mainLang="ar"/>
                                                </msItem>
                                                <msItem xml:id="bnf-arabe-6-item-6">
                                                    <locus from="295v" to="358"/>
                                                    <title>Deuteronomy</title>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Text identical to that of MS Arabe 3.</note>
                                                </msItem>

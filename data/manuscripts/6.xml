                                                            <note xml:lang="ar"/>
                                                        </support>
                                                        <extent>
                                                            <measure unit="folio">266</measure>
                                                            <dimensions>
                                                                <height unit="mm">27cm</height>
                                                                <width unit="mm">16cm</width>
                                                            </dimensions>
                                                        </extent>
                                                        <collation>
                                                            <formula>2</formula>
                                                            <note xml:lang="ar">
                                                                <p>The manuscript is written in a script intermediate between Kufic and early Naskh. Titles and section headings are written in red ink.</p>
                                                            </note>
                                                        </collation>
                                                        <condition>
                                                            <note xml:lang="ar">
                                                                <p>The presence of several distinct scribal hands and the use of different inks suggest that the manuscript was written by more than one scribe, possibly at different periods.</p>
                                                            </note>
                                                        </condition>
                                                    </supportDesc>
                                                    <layoutDesc>

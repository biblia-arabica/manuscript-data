                            <text>
                                <body>
                                    <listBibl>
                                        <msDesc>
                                            <msIdentifier>
                                                <country>United Kingdom</country>
                                                <settlement>Oxford</settlement>
                                                <repository>Bodleian Library</repository>
                                                <collection>Oriental Manuscripts Huntington Collection</collection>
                                                <idno>MS. Huntington 245</idno>
                                                <altIdentifier type="ieArk">
                                                    <idno>ark:29072/x08w32r629hn</idno>
                                                </altIdentifier>
                                                <altIdentifier type="crArk">
                                                    <idno>ark:29072/x08s45q9466s</idno>
                                                </altIdentifier>
                                            </msIdentifier>
                                            <msContents>
                                                <summary xml:lang="en">15 works by 9 authors on the subjects of Christian writings, Monasticism and religious orders, Christian Theology, and Tales</summary>
                                                <msItem xml:id="msitem-1">
                                                    <locus from="1" to="8"/>
                                                    <title>Letter [also attributed to Nilus of Ancyra d.c. 430 ] to Eulogius concerning monastic life, followed by a commentary on the Lordʼs Prayer</title>
                                                    <author>Evagrius Ponticus d. 399</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Incomplete
ff. i and 203 Coptic leaves forming wrapper to MS.
Source text-unit number: 1</note>
                                                </msItem>
                                                <msItem xml:id="msitem-2">
                                                    <locus from="9" to="17"/>
                                                    <title>Collection of directives to his monks, followed by Macariusʼ reply to what a man should do when misled by the Devil</title>
                                                    <author>Macarius of Egypt d.c. 390</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 2</note>
                                                </msItem>
                                                <msItem xml:id="msitem-3">
                                                    <locus from="17" to="19"/>
                                                    <title>Rules for his monks at Dayr al-Naqlūn</title>
                                                    <author>Antony of Egypt d. 356</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 3</note>
                                                </msItem>
                                                <msItem xml:id="msitem-4">
                                                    <locus from="19" to="28"/>
                                                    <title>Treatise on the discipline of monks</title>
                                                    <author>Pachomius d. 346</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 4</note>
                                                </msItem>
                                                <msItem xml:id="msitem-5">
                                                    <locus from="29" to="30"/>
                                                    <title>Collection of rules for those entering the order, by one [??] .</title>
                                                    <author>Anonymous</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 5</note>
                                                </msItem>
                                                <msItem xml:id="msitem-6">
                                                    <locus from="31" to="36"/>
                                                    <title>General reflections of a theological nature</title>
                                                    <author>John Thebaita fl. 4th cent.</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 6</note>
                                                </msItem>
                                                <msItem xml:id="msitem-7">
                                                    <locus from="36" to="44"/>
                                                    <title>Collection of directives etc. on the salvation of the soul, assembled by the [?] scribe or compiler of the MS.</title>
                                                    <author>Anonymous</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 7</note>
                                                </msItem>
                                                <msItem xml:id="msitem-8">
                                                    <locus from="44" to="87"/>
                                                    <title>Directives to the monks</title>
                                                    <author>Isaiah of Scete d. 488</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">f. 70r (subsequently crossed through) repeats f. 64r, and both bear the same Coptic numeration; there is no folio bearing the number 249 in Coptic numeration
Source text-unit number: 8</note>
                                                </msItem>
                                                <msItem xml:id="msitem-9">
                                                    <locus from="87" to="90"/>
                                                    <title>Story of the three women in the time of Constantine</title>
                                                    <author>Anonymous</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 9</note>
                                                </msItem>
                                                <msItem xml:id="msitem-10">
                                                    <locus from="90" to="91"/>
                                                    <title>Short treatise affirming his faith</title>
                                                    <author ref="http://viaf.org/viaf/46897094/">Gregory, of Nazianzus, Saint d. c. 390</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">f. 91 contains debate demonstrating the virtues of silence, including the story of John [-? the Baptist]ʼs silence; a note on 91v identifies the MS. as the property of the monastery at Baramūs
Source text-unit number: 10</note>
                                                </msItem>
                                                <msItem xml:id="msitem-11">
                                                    <locus from="92" to="92"/>
                                                    <title>Ecclesiastes 11, ix - 12, viii, entitled Li-ajl inqiḍāʼ ḥayāt al-insān wa-mawtihi min ākhir kitāb Amthāl Sulaymān</title>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 11</note>
                                                </msItem>
                                                <msItem xml:id="msitem-12">
                                                    <locus from="92" to="120"/>
                                                    <title>Anonymous treatise on the purity of the soul and cleanliness of the body [ ṭahārat al-nafs wa-naqāwat al-jasad ]</title>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 12</note>
                                                </msItem>
                                                <msItem xml:id="msitem-13">
                                                    <locus from="121" to="122"/>
                                                    <title xml:lang="ar-Latn-x-lc">Risālah</title>
                                                    <author>Theodorus, disciple of Pachomius</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 13</note>
                                                </msItem>
                                                <msItem xml:id="msitem-14">
                                                    <locus from="122" to="186"/>
                                                    <title>A collection of directives etc. by Antony of Egypt d. 356 and others, assembled by the [?] scribe or compiler of the MS.</title>
                                                    <author>Anonymous</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">Source text-unit number: 14</note>
                                                </msItem>
                                                <msItem xml:id="msitem-15">
                                                    <locus from="186" to="202"/>
                                                    <title>Collection of dicta etc. [ Majmūʻ min qawl al-qiddīsīn ʻalá taqwīm al-faḍāʼil ], assembled by the [?] scribe or compiler of the MS.</title>
                                                    <author>Anonymous</author>
                                                    <textLang mainLang="ar"/>
                                                    <note xml:lang="en">ff. 197-202 in a different hand, from another MS.
Source text-unit number: 15</note>
                                                </msItem>
                                            </msContents>
